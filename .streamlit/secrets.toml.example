# Copy this file to .streamlit/secrets.toml and fill in your real key(s).
# .streamlit/secrets.toml must never be committed to version control.
#
# The HRMS Multi-Agent Assistant tab supports two providers, selectable in the
# UI (Model provider settings). You only need to set the key(s) for the
# provider(s) you plan to use — the UI also lets a presenter paste in a key at
# runtime instead, which overrides whatever is set here for that session.

GROQ_API_KEY = "your-groq-key-here"
OPENAI_API_KEY = "your-openai-key-here"
